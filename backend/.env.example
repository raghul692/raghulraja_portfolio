# =================================================================
# Backend Environment Configuration Template (Production & Local)
# IMPORTANT: Never commit actual passwords or private keys to git!
# =================================================================

# Database Settings (Supabase PostgreSQL + pgvector)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
SUPABASE_URL=https://<SUPABASE_PROJECT_ID>.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_DB_HOST=db.<SUPABASE_PROJECT_ID>.supabase.co
SUPABASE_DB_USER=portfolio_app
SUPABASE_DB_PASSWORD=your_db_password_here
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PORT=5432

# Email Delivery Settings (Resend API Recommended)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
TO_EMAIL=your_email@gmail.com

# Optional SMTP Email Settings (Fallback)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password_here

# Gemini AI Key
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Webhook Secret
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
